# Base URL of the existing Next.js backend (qube-space-login/checkin-app).
# Tunneled through ngrok (see /tmp/ngrok.log) so this stays stable regardless
# of the dev machine's LAN IP or Wi-Fi network — requires `ngrok http 3000
# --url=https://botch-catchable-hatchback.ngrok-free.dev` running alongside
# the backend dev server.
EXPO_PUBLIC_API_URL=https://botch-catchable-hatchback.ngrok-free.dev
