# Base URL of the backend. Points at the local dev server via an ngrok
# tunnel for normal local-backend development — the ngrok URL changes every
# time the tunnel is restarted (unless you're on a paid plan with a
# reserved domain), so update this whenever you restart ngrok. Swap to the
# production URL (https://qubespace-checkin-out.vercel.app) only when you
# deliberately need to test against production.
EXPO_PUBLIC_API_URL=https://botch-catchable-hatchback.ngrok-free.dev
